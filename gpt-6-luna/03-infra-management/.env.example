# Copy to .env and replace the password before starting the stack.
# A hexadecimal secret is URL-safe in DATABASE_URL; generate one with:
#   openssl rand -hex 32
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
POSTGRES_DB=app

# Host port for nginx. Postgres, Redis, and the API are not published.
HTTP_PORT=8080

# Python WSGI module, in Gunicorn's module:variable form.
APP_MODULE=app:app
