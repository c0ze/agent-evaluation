# Copy to .env and fill in real secrets. Never commit .env.
#   cp .env.example .env
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-32-chars-min
POSTGRES_DB=app
REDIS_PASSWORD=change-me-32-chars-min

# App wiring (must match the passwords above).
DATABASE_URL=postgresql://app:change-me-32-chars-min@db:5432/app
REDIS_URL=redis://:change-me-32-chars-min@cache:6379/0
