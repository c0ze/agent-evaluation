# Copy to .env and set real secrets before first start:
#   cp .env.example .env
# Never commit .env (see RUNBOOK.md).

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=app

# Host port mapped to nginx:80. Container ports stay fixed.
NGINX_HTTP_PORT=80

# Redis has no password and is reachable only on the internal backend
# network. If you need auth, set REDIS_PASSWORD here AND update the
# cache command/healthcheck and the api REDIS_URL in compose.yaml.
# REDIS_PASSWORD=change-me-too
