# Copy to .env and fill in the two passwords (commands in RUNBOOK.md).
# .env is git-ignored and docker-ignored. Never commit it.
# Compose refuses to start while a required value is empty.

POSTGRES_USER=app
POSTGRES_DB=app
# Required. Use URL-safe characters only (hex is ideal): these values are
# embedded in DATABASE_URL / REDIS_URL. Example: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Where nginx is published on the host. Default is loopback only.
# For a public host use PROXY_BIND=0.0.0.0 PROXY_PORT=80 (and put TLS in front).
PROXY_BIND=127.0.0.1
PROXY_PORT=8080

# Image tag for the API. Bump per release; roll back by setting the old tag.
API_TAG=local

# Optional overrides (defaults shown).
# APP_MODULE=app:app
# WEB_CONCURRENCY=2
