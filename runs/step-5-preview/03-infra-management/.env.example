# Copy this file to .env and fill in real values. Compose reads .env
# automatically for variable interpolation; .env must never be committed.

# Host port published by the nginx proxy.
HTTP_PORT=8080

# Host-only bind for the API (debugging / load-generator access); the API is
# normally reached through the proxy on $HTTP_PORT.
API_PORT=8000

# Postgres credentials used by both the db service and the API's DATABASE_URL.
# Use a long random value; avoid characters that are special in URLs
# (@ : / ? #) or percent-encode the password.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-use-a-long-random-value
POSTGRES_DB=app

# Example of a read-only, host-only API bind if you do not need it published:
# (delete the ports entry in compose.yaml instead of uncommenting here)
