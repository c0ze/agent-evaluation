# Copy to .env: `cp .env.example .env` then replace every placeholder.
# .env is git-ignored and docker-ignored. Never commit real values.
# Generate strong values, e.g.: openssl rand -hex 32

# --- Postgres (also used to build DATABASE_URL) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_SECRET
POSTGRES_DB=app

# --- Redis (server --requirepass and API REDIS_URL) ---
REDIS_PASSWORD=CHANGE_ME_GENERATE_ANOTHER_STRONG_SECRET

# --- Public bind address for nginx ---
# Use 127.0.0.1:80 to expose only on localhost, or 0.0.0.0:80 for all interfaces.
HTTP_PORT=127.0.0.1:80
