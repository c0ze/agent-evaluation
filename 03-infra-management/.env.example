# ==============================================================================
# Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Adjust credentials and settings for your environment before starting.
# 3. NEVER commit the resulting .env file to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=app

# Application Server Configuration
FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-secret-key
GUNICORN_WORKERS=2
GUNICORN_THREADS=2

# Web Proxy Configuration (Nginx)
HTTP_PORT=80
