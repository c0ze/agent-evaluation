# Copy to `.env` and fill in real values:  cp .env.example .env && chmod 600 .env
# Never commit `.env`. Generate secrets with:
#   openssl rand -hex 32
# Compose fails fast if POSTGRES_PASSWORD or REDIS_PASSWORD is unset/empty.

POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=app

REDIS_PASSWORD=replace-with-a-different-long-random-value

# Optional: host port for nginx (compose.yaml publishes 80 by default).
# NGINX_PORT=80
