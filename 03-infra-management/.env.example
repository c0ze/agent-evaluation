# Copy to .env and fill in the empty values. Never commit .env.
#   cp .env.example .env && chmod 600 .env
# Compose refuses to start while a required value is empty.
# Generate secrets with:  openssl rand -hex 32
# Hex output is URL-safe, which the DATABASE_URL and REDIS_URL built in compose.yaml require.

# Host port for the proxy. Bound to 127.0.0.1 only.
HTTP_PORT=8080

POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Optional: run a specific image instead of the locally built one (see RUNBOOK.md, rollback)
# APP_IMAGE=api:local
