# Copy to .env, chmod 600, and fill both passwords before running Compose.
# Generate each independently with: python3 -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app
REDIS_PASSWORD=

# Local HTTP only. See RUNBOOK.md before exposing this beyond the host.
PROXY_BIND=127.0.0.1
HTTP_PORT=8080

# Use a distinct API_IMAGE tag for each release; retain the previous image.
API_IMAGE=small-api:local
# These can also be set to approved repository@sha256:... references.
PYTHON_IMAGE=python:3.13.7-slim-bookworm
NGINX_IMAGE=nginx:1.28.0-alpine
POSTGRES_IMAGE=postgres:17.6-bookworm
REDIS_IMAGE=redis:7.4.5-bookworm
