# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env && chmod 600 .env
#
# Generate strong secrets, e.g.:  openssl rand -hex 32
# Keep POSTGRES_PASSWORD alphanumeric (or URL-encode it): it is
# interpolated into DATABASE_URL in compose.yaml.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# --- Publishing ---------------------------------------------------------
# Host port for the nginx proxy (the ONLY port published to the host).
HTTP_PORT=80

# --- Deployments / rollback ---------------------------------------------
# Tag built API images per release (see RUNBOOK.md, "Rollback").
IMAGE_TAG=local
