# Copy to .env and replace every placeholder:  cp .env.example .env
# .env is never committed and is excluded by .dockerignore.

# ---- Postgres (used by the `db` service and to build DATABASE_URL) ----
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# ---- Redis (cache; also used to build REDIS_URL) ----
REDIS_PASSWORD=change-me-too

# ---- API ----
# WSGI entrypoint, e.g. "myapp.wsgi:application"
APP_MODULE=app:app
WEB_CONCURRENCY=2
HEALTHCHECK_PATH=/healthz
LOG_LEVEL=info

# ---- Host port published by the proxy ----
HTTP_PORT=80

# ---- Image tag applied to the locally built api image (rollback knob) ----
IMAGE_TAG=local
