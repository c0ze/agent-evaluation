ds:\n            raise KeyError(key)\n        return value\n\n    def __len__(self):\n        return len(self._items)\n\n","numLines":28,"startLine":1,"totalLines":28}},"tool_result_meta":[{"id":"toolu_012WKyvfgPxfAJG4BRqgPNuy","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
