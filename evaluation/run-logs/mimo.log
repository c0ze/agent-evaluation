from html.parser import HTMLParser
class P(HTMLParser):
    def __init__(self):
        super().__init__()
        self.stack=[]
        self.errors=[]
        self.void={'meta','link','br','hr','img','input','source','area','base','col','embed','param','track','wbr'}
    def handle_starttag(self, tag, attrs):
        if tag not in self.void:
            self.stack.append(tag)
    def handle_endtag(self, tag):
        if tag in self.void: return
        if not self.stack:
            self.errors.append(f'extra close </{tag}>'); return
        if self.stack[-1]!=tag:
            self.errors.append(f'mismatch expected </{self.stack[-1]}> got </{tag}>')
            if tag in self.stack:
                while self.stack and self.stack[-1]!=tag: self.stack.pop()
                if self.stack: self.stack.pop()
        else:
            self.stack.pop()
p=P()
p.feed(open('index.html').read())
print('HTML errors:', p.errors or 'none')
print('Unclosed:', p.stack or 'none')
