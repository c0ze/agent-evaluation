# Copy to .env before running:  cp .env.example .env
# .env is git-ignored and must never be committed or baked into an image.
# Every value below is REQUIRED: compose fails fast on any missing variable.

# --- Postgres (db service) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# --- Redis (cache service) ---
# Generate with:  openssl rand -base64 32
REDIS_PASSWORD=change-me-too

# --- API tuning (optional overrides) ---
# WEB_CONCURRENCY=4
# LOG_LEVEL=info
