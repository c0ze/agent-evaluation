# Never bake local configuration or secrets into the image.
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Version control / tooling
.git
.gitignore
.github
.vscode
.idea

# Local project noise
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Docs and infra files that are not runtime code
*.md
Dockerfile
.dockerignore
compose.yaml
nginx.conf
